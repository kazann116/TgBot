package TgBotRT;

{
  Пакет времени выполнения библиотеки Telegram Bot API.
  Имя файла пакета получает суффикс версии Delphi (LIBSUFFIX AUTO):
  TgBotRT270.bpl (10.4), TgBotRT280.bpl (11), TgBotRT290.bpl (12);
  .dcp — без суффикса (TgBotRT.dcp).
  TgBot.Types.pas и TgBot.pas подключают Generated\*.inc относительно
  своей папки (Source).
}

{$RUNONLY}
{$IMPLICITBUILD OFF}
{$LIBSUFFIX AUTO}
{$DESCRIPTION 'Telegram Bot API для Delphi (runtime)'}

requires
  rtl;

contains
  TgBot.Consts in '..\Source\TgBot.Consts.pas',
  TgBot.Base in '..\Source\TgBot.Base.pas',
  TgBot.Json in '..\Source\TgBot.Json.pas',
  TgBot.Intf in '..\Source\TgBot.Intf.pas',
  TgBot.Transport in '..\Source\TgBot.Transport.pas',
  TgBot.Http in '..\Source\TgBot.Http.pas',
  TgBot.Dto in '..\Source\TgBot.Dto.pas',
  TgBot.Core in '..\Source\TgBot.Core.pas',
  TgBot.Types in '..\Source\TgBot.Types.pas',
  TgBot.Updates.Types in '..\Source\TgBot.Updates.Types.pas',
  TgBot.Updates.Dispatcher in '..\Source\TgBot.Updates.Dispatcher.pas',
  TgBot.Updates.Polling in '..\Source\TgBot.Updates.Polling.pas',
  TgBot.Updates.WebhookSource in '..\Source\TgBot.Updates.WebhookSource.pas',
  TgBot.Updates in '..\Source\TgBot.Updates.pas',
  TgBot.State in '..\Source\TgBot.State.pas',
  TgBot.Keyboards in '..\Source\TgBot.Keyboards.pas',
  TgBot.Context in '..\Source\TgBot.Context.pas',
  TgBot.Router in '..\Source\TgBot.Router.pas',
  TgBot.Bot.Core in '..\Source\TgBot.Bot.Core.pas',
  TgBot.Bot in '..\Source\TgBot.Bot.pas',
  TgBot in '..\Source\TgBot.pas',
  TgBot.Component in '..\Source\TgBot.Component.pas';

end.
